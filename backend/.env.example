APP_NAME='Presupuesto Estudiantil'
DATABASE_URL=postgresql+psycopg://budget:budget@localhost:5432/budget
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_MINUTES=10080
RECOVERY_CODE_MINUTES=15
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Correo para "¿Olvidaste tu contraseña?". Si se deja vacio, el codigo de 4 digitos
# aparece en la consola del backend (sirve para desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# En la nube (Render gratis bloquea SMTP): clave de API de Brevo. Si se llena, el correo
# sale por Brevo usando SMTP_FROM como remitente (debe estar verificado en Brevo).
BREVO_API_KEY=
